{
  "name": "@datalayer/design",
  "version": "1.0.0",
  "private": false,
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "style"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/datalayer-design/landing.git"
  },
  "homepage": "https://datalayer.design",
  "scripts": {
    "build": "npm run clean && tsc && npm run copy:svg-assets && vite build",
    "build:lib": "tsc && npm run copy:svg-assets",
    "clean": "rimraf lib build dist tsconfig.tsbuildinfo",
    "copy:svg-assets": "mkdir -p lib/svg/images && cp src/svg/images/datalayer-*.svg lib/svg/images/",
    "dev": "vite",
    "landing:app": "npm run copy:svg-assets && tsc --watch",
    "preview": "vite preview",
    "start": "vite",
    "watch:lib": "npm run copy:svg-assets && tsc -w"
  },
  "dependencies": {
    "@datalayer/icons-react": "^1.0.0",
    "@datalayer/primer-addons": "^1.0.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.30.1",
    "styled-components": "^5.3.10"
  },
  "devDependencies": {
    "@babel/core": "^7.12.10",
    "@babel/plugin-transform-react-jsx": "^7.12.12",
    "@svgr/core": "^5.5.0",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "@vitejs/plugin-react": "^4.5.2",
    "postcss": "^8.4.23",
    "prettier": "^3.3.2",
    "rimraf": "^6.0.1",
    "svgo": "^1.3.2",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-svgr": "^4.3.0"
  }
}
